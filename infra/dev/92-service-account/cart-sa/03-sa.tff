# ----------------------------------------------------------
# Create Service Account: "cart-sa"
# ----------------------------------------------------------
resource "kubernetes_service_account" "cart_sa" {
  metadata {
    name      = var.service_account       # car-sa
    namespace = var.namespace             # ecommerce-dev

    annotations = {
      "eks.amazonaws.com/role-arn" = aws_iam_role.cart_role.arn
    }
  }
}
